{
  "name": "ADEZ-XMD",
  "description": "WhatsApp bot build by Árñóld Adez",
  "repository": "https://github.com/ADEZTECH/ADEZ-XMD",
  "logo": "https://avatars.githubusercontent.com/u/266355808?v=4",
  "env": {
    "SESSION_ID": {
      "description": "Your WhatsApp session ID for ADEZ-XMD. Optional if you are using a stored session.",
      "required": false
    },
    "OWNER_NUMBER": {
      "description": "Your WhatsApp number without the + sign.",
      "required": false
    },
    "PORT": {
      "description": "Port for the web server.",
      "value": "5000"
    },
    "NODE_ENV": {
      "description": "Node environment.",
      "value": "production"
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "buildpacks": [
    { "url": "heroku/nodejs" }
  ]
}
